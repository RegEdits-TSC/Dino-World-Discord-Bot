{
  "name": "dino-world-bot",
  "version": "1.0.0",
  "description": "A dinosaur park tycoon game played entirely inside Discord",
  "private": true,
  "main": "index.js",
  "keywords": [
    "discord",
    "discord-bot",
    "discordjs",
    "typescript",
    "sqlite",
    "drizzle-orm",
    "game"
  ],
  "author": "RegEdits-TSC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RegEdits-TSC/Dino-World-Discord-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/RegEdits-TSC/Dino-World-Discord-Bot/issues"
  },
  "homepage": "https://github.com/RegEdits-TSC/Dino-World-Discord-Bot#readme",
  "directories": {
    "doc": "docs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "tsx scripts/test-live.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "build-emojis": "tsx src/build-emojis.ts",
    "deploy-emojis": "tsx src/deploy-emojis.ts",
    "make-gif": "tsx scripts/make-gif.ts",
    "deploy-branding": "tsx src/deploy-branding.ts",
    "backfill-species-seen": "tsx scripts/backfill-species-seen.ts"
  },
  "type": "module",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.3",
    "better-sqlite3": "^13.0.2",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "drizzle-kit": "^0.31.10",
    "ffmpeg-static": "^5.3.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
