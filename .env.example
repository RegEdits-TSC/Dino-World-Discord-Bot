DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DATABASE_PATH=./dino-world.db
OWNER_ID=your-discord-user-id
# Optional: set to a guild id to deploy slash commands to that guild only (instant, for dev/testing).
# Leave unset in production to deploy commands globally.
DEV_GUILD_ID=
# Channel in the dev guild where the live test sweep posts every command's output.
TEST_CHANNEL_ID=
